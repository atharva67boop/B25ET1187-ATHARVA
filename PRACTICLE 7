#include <iostream>
#include <string>
using namespace std;

class String
{
    string name;

public:
    // Constructor
    String()
    {
        cout << "Constructor called" << endl;
    }

    // Accept function
    void Accept()
    {
        cout << "Enter student's name: ";
        getline(cin, name);
    }

    // Display function
    void Display()
    {
        cout << "Student's name: " << name << endl;
    }

    // Destructor
    ~String()
    {
        cout << "Destructor called";
    }
};

int main()
{
    String s;

    s.Accept();
    s.Display();

    return 0;
}
