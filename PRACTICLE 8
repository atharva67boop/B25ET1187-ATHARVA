
#include <iostream>
using namespace std;

// Base class for employee information
class Employee
{
protected:
    int emp_id;
    string name;
    float salary;

public:
    void getEmployee()
    {
        cout << "Enter Employee ID: ";
        cin >> emp_id;

        cout << "Enter Employee Name: ";
        cin >> name;

        cout << "Enter Monthly Salary: ";
        cin >> salary;
    }
};

// Base class for insurance information
class Insurance
{
protected:
    float insurance_rate;

public:
    void getInsurance()
    {
        cout << "Enter Insurance Rate (%): ";
        cin >> insurance_rate;
    }
};

// Derived class using multiple inheritance
class Contribution : public Employee, public Insurance
{
public:
    void calculate()
    {
        float annual_salary = salary * 12;
        float contribution = annual_salary * insurance_rate / 100;

        cout << "\n--- Employee Details ---" << endl;
        cout << "Employee ID: " << emp_id << endl;
        cout << "Employee Name: " << name << endl;
        cout << "Annual Salary: " << annual_salary << endl;
        cout << "Insurance Rate: " << insurance_rate << "%" << endl;
        cout << "Annual Insurance Contribution: "
             << contribution << endl;
    }
};

int main()
{
    Contribution obj;

    obj.getEmployee();
    obj.getInsurance();
    obj.calculate();

    return 0;
}
